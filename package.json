{
  "name": "consorcio-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "worker": "tsx src/jobs/worker.ts",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:proteger-datos": "tsx prisma/proteger-datos.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,md,json,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.41.0",
    "bullmq": "^6.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
