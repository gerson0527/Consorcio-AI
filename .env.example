# Copia este archivo a .env y completa los secretos.
# Los valores de conexión son solo para el entorno local de Docker.
# No los uses en producción.

DATABASE_URL=postgresql://consorcio:consorcio@localhost:5432/consorcio?schema=public
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_SECRET=
APP_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=consorcio-documentos
S3_ACCESS_KEY=
S3_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
# Clave de Coarena (https://coarena.ai). Si queda vacía, se usa el procesamiento local.
ANTHROPIC_API_KEY=
# El proveedor y la dimensión se deciden en la Fase 3.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=
CALIBRACION_MIN_MUESTRAS=30
REGLA_SUGERIDA_MIN_SOPORTE=10
REGLA_SUGERIDA_MIN_PRECISION=0.9
